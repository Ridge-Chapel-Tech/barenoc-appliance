# BareNOC Environment Configuration
# Copy to .env and fill in real values, then chmod 600.
# WARNING: .env contains secrets. It is gitignored — never commit it.

# Database
DATABASE_URL=sqlite:////opt/barenoc/volumes/db/barenoc.db

# JWT — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
DEBUG=false
LOG_LEVEL=info
SITE_ID=1
CUSTOMER_NAME=Demo Site
# BRANDING_LOGO=logo_1710000000000.png  (set automatically when a logo is uploaded via Settings)

# LLM (multi-provider — use whatever provider the customer pays for)
# Failover chain: primary → secondary → tertiary. The worker tries each in
# order; on failure/timeout/consecutive-failure-count it fails over, and opens
# a P1 ticket when the whole chain is unusable. Each provider must match a
# configured LLM_PROVIDER_<NAME> block below.
LLM_ACTIVE_PROVIDER=deepseekv4
# LLM_PROVIDER_ORDER=deepseekv4,ollama   # primary,secondary,tertiary (Settings UI)
# LLM_TIMEOUT_S=30                       # per-provider call timeout (failover on exceed)
# LLM_PROVIDER_DOWN_AFTER=3              # consecutive failures before a provider is skipped

# deepseekv4 (default — DeepSeek v4-flash, OpenAI-compatible)
LLM_PROVIDER_DEEPSEEKV4_TYPE=openai
LLM_PROVIDER_DEEPSEEKV4_BASE_URL=https://api.deepseek.com
LLM_PROVIDER_DEEPSEEKV4_DEPLOYMENT=hosted   # hosted | on_prem (Ollama/LM Studio LAN = on_prem)
# LLM_PROVIDER_DEEPSEEKV4_API_KEY=sk-your-key-here
LLM_PROVIDER_DEEPSEEKV4_CHAT_MODEL=deepseek-v4-flash
LLM_PROVIDER_DEEPSEEKV4_REASONER_MODEL=deepseek-v4-flash
# LLM_PROVIDER_DEEPSEEKV4_JUDGE_MODEL=deepseek-v4-flash   # judge tier (defaults to reasoner model)
LLM_PROVIDER_DEEPSEEKV4_THINKING=disabled   # v4 is a reasoning model; disable for fast JSON
LLM_PROVIDER_DEEPSEEKV4_INPUT_PRICE=0.27    # USD per 1M tokens (static mode)
LLM_PROVIDER_DEEPSEEKV4_OUTPUT_PRICE=1.10
LLM_PROVIDER_DEEPSEEKV4_PRICE_MODE=static

# Example: Anthropic (Claude)
# LLM_PROVIDER_CLAUDE_TYPE=anthropic
# LLM_PROVIDER_CLAUDE_BASE_URL=https://api.anthropic.com
# LLM_PROVIDER_CLAUDE_API_KEY=sk-ant-...
# LLM_PROVIDER_CLAUDE_CHAT_MODEL=claude-sonnet-4-20250514
# LLM_PROVIDER_CLAUDE_REASONER_MODEL=claude-opus-4-20250514
# LLM_PROVIDER_CLAUDE_PRICE_MODE=static

# Example: Google Gemini
# LLM_PROVIDER_GEMINI_TYPE=gemini
# LLM_PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# LLM_PROVIDER_GEMINI_API_KEY=AIza...
# LLM_PROVIDER_GEMINI_CHAT_MODEL=gemini-2.0-flash
# LLM_PROVIDER_GEMINI_REASONER_MODEL=gemini-2.0-flash
# LLM_PROVIDER_GEMINI_PRICE_MODE=static

# Example: on-LAN Ollama (on-prem fallback) — $0 pricing
# LLM_PROVIDER_OLLAMA_TYPE=openai
# LLM_PROVIDER_OLLAMA_BASE_URL=http://10.0.10.20:11434
# LLM_PROVIDER_OLLAMA_DEPLOYMENT=on_prem
# LLM_PROVIDER_OLLAMA_CHAT_MODEL=llama3.1:8b
# LLM_PROVIDER_OLLAMA_REASONER_MODEL=llama3.1:8b
# LLM_PROVIDER_OLLAMA_PRICE_MODE=zero

# Pricing: auto = live fetch (OpenRouter/Together) else static table;
# live = require live; static = table/env only; zero = $0 (local)
# LLM_PRICE_MODE=auto
# LLM_PRICE_CACHE_TTL_H=24

# Two-phase judge/executor pipeline (prototype): the JUDGE (frontier/reasoner
# model) rules on lawfulness + picks the action class; the EXECUTOR (chat
# model) fills in the concrete job. Output still passes action_validator + gates.
# Default OFF = current single-phase AI Technician behavior.
# LLM_JUDGE_ENABLED=true
# LLM_VERDICT_CACHE_TTL_H=24   # judge verdict cache TTL (hours)

# Per-deployment autonomy policy (overrides LLM_JUDGE_ENABLED semantics):
#   autonomous = home/owner: risk filters OFF, writes auto-exec, NO approval queue
#   balanced   = SMB owner-operator: judge on, writes auto-exec >= 0.90, P1 -> approval
#   strict     = Tier II support: judge on, all risk filters, writes + P1/P2 -> approval
# LLM_POLICY_PROFILE=balanced
# Granular overrides (win over profile):
# LLM_POLICY_RISK_FILTERS=all            # all | none | maintenance,security,network,identity,install,change
# LLM_POLICY_JUDGE_REQUIRED=true
# LLM_POLICY_WRITE_AUTOEXEC=true
# LLM_POLICY_AUTOEXEC_THRESHOLD=0.90
# LLM_POLICY_APPROVAL_PRIORITIES=P1,P2
# PATCH_ALLOWLIST=FW-6.6.55,FW-6.6.52   # firmware IDs apply_patch may use; * = any (home deployments)
# LLM_RETRY_INTERVAL_MIN=2              # worker retries failed LLM calls every N min (default 2)
# LLM_RETRY_MAX_ATTEMPTS=10             # after N failed attempts the ticket escalates to a human

# Network discovery (non-UniFi sites only): the /24 prefix the "Scan Network"
# button pings (default 192.168.4). UniFi deployments get inventory from the
# controller instead.
# Discovery (non-UniFi): multi-VLAN ping sweep + SNMP gear sweep
# DISCOVERY_SUBNETS=192.168.4.0/24,192.168.8.0/24   # comma list of VLAN CIDRs
# DISCOVERY_SNMP_COMMUNITY=public                    # community for the SNMP sweep
# DISCOVERY_MAX_HOSTS_PER_SUBNET=50                  # ping-sweep cap per subnet

# Lily (the AI assistant, EXPERIMENTAL): in Autonomous mode, open-ended tickets
# are dispatched to the on-appliance agent Lily (full tool access, no approval
# gates). Requires the pi runtime installed for the pi-agent user + a key in
# Settings. The service/OS account keeps the machine name pi-agent.
# PI_AGENT_ENABLED=false
# PI_AGENT_BIN=/home/pi-agent/.local/share/pi-node/current/bin/pi
# PI_AGENT_WORKDIR=/opt/barenoc/pi-work

# Bot names (shown in chat + tickets; editable in Settings -> General)
BOT_QUEUE_MANAGER_NAME=Juniper
BOT_ASSISTANT_NAME=Lily

# Desktop chat client (AIM-style buddy app; editable in Settings -> General)
# false gates the Downloads page + chat API (the client cannot sign in)
CHAT_CLIENT_ENABLED=true

# Appliance identity (Settings → Identity → Appliance identity & DNS)
# The console hostname MUST be a real registrable domain for passkeys.
# The DNS service (CoreDNS, port 53) answers for these names + forwards the rest.
# APPLIANCE_IP=192.168.4.207
# APPLIANCE_DOMAIN=bareNOC.com
# APPLIANCE_HOST=app.bareNOC.com

# Pocket ID (OIDC/passkeys) — external URL Pocket ID advertises as its issuer
# APP_URL=https://<host>:8443   # Pocket ID external URL (v2.12 env var — PUBLIC_APP_URL is IGNORED)
# ENCRYPTION_KEY=<generate: python3 -c "import secrets; print(secrets.token_hex(32))">
# OIDC_ENABLED=true
# OIDC_PROVIDER_URL=https://<host>/auth/pocket-id/
# OIDC_CLIENT_ID=barenoc
# OIDC_CLIENT_SECRET=...
# OIDC_GROUP_ADMIN=barenoc-admins
# OIDC_GROUP_OPERATOR=barenoc-operators
# GitHub / Google OAuth login (config only — flows are future work; off until configured)
# GITHUB_LOGIN_ENABLED=false
# GITHUB_CLIENT_ID=github-oauth-client-id
# GITHUB_CLIENT_SECRET=github-oauth-client-secret
# GOOGLE_LOGIN_ENABLED=false
# GOOGLE_LOGIN_CLIENT_ID=google-oauth-client-id
# GOOGLE_LOGIN_CLIENT_SECRET=google-oauth-client-secret

# Email (configured in M2)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=admin@example.com, oncall@example.com   # comma-separated = multiple recipients

# First admin credentials (used by seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# UniFi Controller (UCG/UDM or legacy) — used by Settings -> UniFi + /api/v1/unifi/*
# UNIFI_URL=https://192.168.4.1:443
# UNIFI_USER=admin
# UNIFI_PASSWORD=controller-local-admin-password
# UNIFI_SITE=default
# UNIFI_API_KEY=local-api-key-from-UniFi-Network-Settings-Integrations  (recommended over password)
# Auto-sync: pull devices/clients from the controller on a schedule (Settings → UniFi).
# Disabled until you enable it — interval in minutes (5, 10, 15, 30, 60).
# UNIFI_AUTOSYNC_ENABLED=false
# UNIFI_AUTOSYNC_INTERVAL_MIN=5
# UNIFI_AUTO_ADOPT=true        # claim UniFi-managed gear automatically on sync (default true)

# Gmail OAuth2 (preferred) — used when set; SMTP above becomes the fallback.
# Requires a GCP OAuth client with the https://www.googleapis.com/auth/gmail.send scope.
# GOOGLE_CLIENT_ID=1234-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REFRESH_TOKEN=1//0xxxx...
# GOOGLE_SENDER=you@gmail.com   # the Gmail account (From address)

# ── Email reporting (Settings → Email) ──
# Per-type recipients (comma-separated; blank falls back to ALERT_RECIPIENTS then ALERT_EMAIL)
# ALERT_RECIPIENTS=oncall@example.com, admin@example.com
# DIGEST_RECIPIENTS=
# EOD_RECIPIENTS=
# Report toggles + send hours (0-23, local)
# REPORT_MORNING_DIGEST=true
# REPORT_EOD_SUMMARY=true
# DIGEST_HOUR=7
# EOD_HOUR=18

# ── Internet / ISP link monitor (alert engine) ──
# Probes the LAN gateway + a public host every N seconds. The UniFi gateway
# stays ONLINE during an ISP outage (LAN side works), so device monitoring
# never catches it — this probe does. A confirmed outage (N consecutive
# failures) opens a P1 "Internet connectivity down" ticket + alert email,
# auto-closed on recovery.
# INTERNET_PROBE_ENABLED=true
# INTERNET_PROBE_GATEWAY=192.168.4.1
# INTERNET_PROBE_HOST=1.1.1.1
# INTERNET_PROBE_INTERVAL_S=60
# INTERNET_PROBE_CONFIRM=3

# ── Ticket lifecycle (Settings → Tickets) ──
# Check in with a human/customer every N hours on escalated / customer_action
# tickets (0 = never). Auto-close a ticket N days after the AI resolved it
# (0 = never). All hot-reloaded by the alert engine (~1 min).
# TICKET_CHECKIN_ENABLED=true
# TICKET_CHECKIN_EMAIL=true
# TICKET_AUTOCLOSE_ENABLED=true
# TICKET_CHECKIN_HOURS_P1=1   # P2=4, P3=24, P4=24
# TICKET_CLOSE_AFTER_DAYS_P1=3  # P2=3, P3=3, P4=3

# ── Reporting (Dashboard → Performance & Reporting) ──
# Cost comparison inputs: the AI support spend is the real LLM bill; the
# estimated manned-NOC cost is resolved_tickets x hours_per_ticket x labor
# rate (an estimate, labeled as such). Savings = manned-NOC minus AI spend.
# SUPPORT_LABOR_RATE_USD=45
# SUPPORT_HOURS_PER_TICKET=1.0

# ── Licensing & updates ─────────────────────────────────────────────────────
# Early-access activation key (binds updates to the purchase email). Set via
# Settings → Licensing or the installer's --activation-key.
# ACTIVATION_KEY=
# LICENSE_EMAIL=
# Public manifests (updates are GATED by the activation key):
# UPDATE_MANIFEST_URL=https://barenoc.com/downloads/versions.json
# ACTIVATION_LIST_URL=https://barenoc.com/downloads/activation-keys.json
# Optional: Proxmox host snapshot/rollback for self-updates (restricted key):
# UPDATE_HOST=root@192.0.2.95
# UPDATE_VMID=1000
# UPDATE_HOST_SSH=/opt/barenoc/volumes/secrets/update-host-key
